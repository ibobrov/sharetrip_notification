# Copy to .env and fill in local credentials. Never commit .env.
# config.Load reads process environment only. Loading .env at application
# startup will be wired with the application lifecycle (task 10).
HTTP_HOST=127.0.0.1
HTTP_PORT=8081

DB_HOST=localhost
DB_PORT=6544
DB_NAME=sharetrip_notification
DB_USER=notification
DB_PASSWORD=
DB_SSLMODE=disable

# Docker Compose: keep these values aligned with DB_* above.
# POSTGRES_PORT is the host port; PostgreSQL listens on 5432 in the container.
POSTGRES_USER=notification
POSTGRES_PASSWORD=
POSTGRES_DB=sharetrip_notification
POSTGRES_PORT=6544

# Goose CLI: set the DSN for the SAME host, port, database and credentials.
# Example shape (replace placeholders; URL-encode username/password):
# postgres://<user>:<password>@localhost:6544/sharetrip_notification?sslmode=disable
# Do not rely on variable interpolation: provide the complete DSN explicitly.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=
